# 抖音文案提取器配置文件
# 复制此文件为 .env 并填入你的 API Key

# ============================================================
# API 提供商配置
# ============================================================

# API 提供商选择: auto | dashscope | siliconflow
# - auto: 自动检测（优先使用 dashscope）
# - dashscope: 阿里云百炼（推荐，支持视频 URL 直传）
# - siliconflow: 硅基流动（需要下载视频）
TRANSCRIPTION_PROVIDER=auto

# ============================================================
# 阿里云百炼 API 配置 (推荐)
# ============================================================
# 获取地址：https://dashscope.console.aliyun.com/apiKey
# 特点：支持视频 URL 直传，无需下载和提取音频
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# ============================================================
# 硅基流动 API 配置 (备选)
# ============================================================
# 获取地址：https://cloud.siliconflow.cn/i/TxUlXG3u
# 特点：需要下载视频并提取音频
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here

# ============================================================
# 兼容旧配置
# ============================================================
# 通用 API Key（当上述特定 Key 未设置时使用）
API_KEY=sk-your-api-key-here

# ============================================================
# 服务配置
# ============================================================
# 服务端口（可选，默认 8080）
PORT=8080
